# AgentOS environment configuration
# Copy to .env and adjust as needed.

# Server
AGENTOS_PORT=3000
AGENTOS_HOST=0.0.0.0
NODE_ENV=development

# Data directory (SQLite DB + logs)
AGENTOS_DATA_DIR=~/.agentos

# OpenCode
AGENTOS_OPENCODE_PATH=~/.opencode/bin/opencode
AGENTOS_DEFAULT_MODEL=opencode/big-pickle
AGENTOS_WORKDIR=~/Projects

# Runtime tuning
AGENTOS_CONCURRENCY=2
AGENTOS_TASK_TIMEOUT_MS=600000
AGENTOS_SESSION_MINUTES=480

# Bootstrap credentials (used only on first seed)
AGENTOS_BOOTSTRAP_USER=admin
AGENTOS_BOOTSTRAP_PASSWORD=admin123
