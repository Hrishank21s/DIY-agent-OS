# AgentOS environment configuration
# Copy to .env and adjust as needed.

# Server
AGENTOS_PORT=3000
AGENTOS_HOST=0.0.0.0
NODE_ENV=development

# Runtime mode: 'development' makes cookies non-secure-only (for plain http on
# localhost). Production is the default unless NODE_ENV/AGENTOS_RUNTIME_MODE
# are set to development/test.
# AGENTOS_RUNTIME_MODE=production

# When running behind a reverse proxy that terminates TLS, set to true so the
# app honors X-Forwarded-* headers for client IPs and the protocol.
# AGENTOS_TRUST_PROXY=false

# Origins allowed to make browser (Origin-bearing) state-changing requests.
# Required when the dashboard is reached from a non-loopback address (e.g. LAN):
# browsers reject any state-changing request whose origin is not loopback or
# listed here, so set AGENTOS_PUBLIC_ORIGIN to the exact origin you use.
# AGENTOS_PUBLIC_ORIGIN=http://<your-mac-ip>:3000
# AGENTOS_TRUSTED_ORIGINS=https://one.example.com,https://two.example.com

# Data directory (SQLite DB + logs)
AGENTOS_DATA_DIR=~/.agentos

# OpenCode — only binaries basename'd 'opencode' are accepted.
# AGENTOS_OPENCODE_PATH=/absolute/path/to/opencode
AGENTOS_DEFAULT_MODEL=opencode/big-pickle
AGENTOS_WORKDIR=~/Projects

# Runtime tuning
AGENTOS_CONCURRENCY=2
AGENTOS_TASK_TIMEOUT_MS=600000
AGENTOS_SESSION_MINUTES=480
AGENTOS_APPROVAL_TIMEOUT_MS=86400000

# Bootstrap credentials (used only on first seed). Leave AGENTOS_BOOTSTRAP_PASSWORD
# unset to have a strong random password generated and printed once at first start.
# Production refuses short or well-known weak passwords.
AGENTOS_BOOTSTRAP_USERNAME=admin
# AGENTOS_BOOTSTRAP_PASSWORD=<generate a strong one>